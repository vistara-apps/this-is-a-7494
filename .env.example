# Solana Network Configuration
# Options: mainnet-beta, devnet, testnet, localnet
REACT_APP_NETWORK=devnet

# Program ID (will be updated after deployment)
REACT_APP_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS

# Custom RPC Endpoint (optional)
# REACT_APP_RPC_ENDPOINT=https://your-custom-rpc.example.com

# Anchor Wallet Path (for deployment)
ANCHOR_WALLET=~/.config/solana/id.json

# Feature Flags
REACT_APP_ENABLE_AIRDROPS=true  # Enable airdrop button (devnet/testnet only)
REACT_APP_ENABLE_LOGS=true      # Enable verbose logging

